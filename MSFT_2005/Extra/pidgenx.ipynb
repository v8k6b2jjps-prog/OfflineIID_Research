p = pubkey_data["field"]["modulus"]
a = pubkey_data["curve"]["a"]
b = pubkey_data["curve"]["b"]
order = pubkey_data["field"]["ec_base_order"]
h1_bases = list(map(lambda x: x+1, pubkey_data["h1_bases"]))
KCHARS = "BCDFGHJKMPQRTVWXY2346789"

def decode_pkey(k):
    k = k.replace("-", "")
    out = 0
    
    for c in k:
        out *= 24
        out += KCHARS.index(c)
    
    return out

K = GF(p)
Kx.<x> = K[]
K3.<u> = K.extension(Kx(pubkey_data["field"]["k3_minpoly"]))
K3y.<y> = K3[]
K6.<t> = K3.extension(K3y(pubkey_data["field"]["k6_minpoly"]))

E = EllipticCurve(K, [a, b])
E6 = EllipticCurve(K6, [a, b])

Qi = [E6(K3(point["x"]) * t^-2, K3(point["y"]) * t^-3) for point in pubkey_data["points"]]

# pairing_val = e_m(P, S)
pairing_val = K6([K3(pubkey_data["pairing_val"][0]), K3(pubkey_data["pairing_val"][1])])

assert is_prime(p)
assert len(h1_bases) == len(Qi)
assert h1_bases[0] == 2
assert pairing_val^order == 1

pkey_chars = "33PXH-7Y6KF-2VJC9-XBBR8-HVTHH"

# pkey = HASH(M)
# HASH is a currently unknown hash function
pkey = decode_pkey(pkey_chars)

# h1_coeffs = H1(M)
# During validation, coeffs must be found by a search that i havent implemented
# h1_coeffs = [1, 0, 7, 1, 4, 15, 9, 1, 1, 0, 2, 1, 0, 19]

# 10 bits unknown, 30 bits product ID, 1 bit unknown (upgrade?)
key_data = (342 << 31 | 918500000 << 1 | 0)
h1_coeffs = [1]

for i in range(len(h1_bases) - 1):
    h1_coeffs.append(key_data % h1_bases[i + 1])
    key_data //= h1_bases[i + 1]

print(h1_coeffs)

# H2(M) = E.lift_x(HASH(M) % p)
T = E6(E.lift_x(pkey % p))
Q = sum(map(lambda x: x[0] * x[1], zip(h1_coeffs, Qi))) 

test_pairing = T.tate_pairing(Q, order, 6, q=p)

print(test_pairing == pairing_val or test_pairing == 1/pairing_val)

key_data = 0

for i in range(len(h1_bases) - 1, 0, -1):
    key_data *= h1_bases[i]
    key_data += h1_coeffs[i]
    print(h1_bases[i], h1_coeffs[i], key_data)

pid = (key_data & ((1 << 31) - 1)) >> 1